{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": [
      "ES2022",
      "DOM",
      "ESNext.Disposable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": ".stage1-build",
    "declaration": true,
    "skipLibCheck": true
  },
  "include": [
    "contracts/**/*.ts",
    "contracts/**/*.json",
    "mobile/src/pose/**/*.ts",
    "tests/**/*.ts"
  ]
}
